# Copy these into Streamlit Cloud: app menu -> Settings -> Secrets.
# Do NOT commit the real file. .streamlit/secrets.toml is gitignored.

GEMINI_API_KEY = "your-gemini-key"
GEMINI_MODEL = "gemini-3.5-flash-lite"

MYSQL_HOST = "mysql-xxxx.aivencloud.com"
MYSQL_PORT = "12345"
MYSQL_USER = "avnadmin"
MYSQL_PASSWORD = "your-aiven-password"
MYSQL_DATABASE = "indiashipments"
MYSQL_SSL = "true"
