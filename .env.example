# --- MySQL (Phase 1) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=indiashipments

# --- Gemini (Phase 3) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# real = call Gemini (default). stub = canned replies for UI testing only;
# tools, rules and the database stay real. Never use stub for a demo.
AGENT_MODE=real

# --- External integration (Phase 2) ---
PIN_API_BASE_URL=https://api.postalpincode.in
PIN_API_TIMEOUT_SECONDS=3
